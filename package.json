{
  "name": "personal-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:online": "node scripts/check-online.mjs",
    "lint": "eslint app lib --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "vitest run",
    "verify": "npm run validate:content && npm run typecheck && npm run lint && npm run test && npm run build && npm run check:export"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/postcss": "^4.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
